# ============================================================
# CONTRACTOR-OS STARTER — Environment Variables
# Copy this file to .env and fill in your values.
# In Railway: add these in the Variables tab.
# ============================================================

# ── CORE ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── AI ───────────────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── DATABASE ─────────────────────────────────────────────────
# Railway provides this automatically when you add PostgreSQL
DATABASE_URL=

# ── TELNYX (Phone / Voice) ───────────────────────────────────
# Get from: https://portal.telnyx.com
# Required: API key, the phone number you purchased, and your Call Control App ID
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=+1XXXXXXXXXX
TELNYX_APP_ID=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=

# SMS provider — leave as telnyx
SMS_PROVIDER=telnyx

# ── GHL (GoHighLevel CRM) ────────────────────────────────────
# Get from: GoHighLevel → Settings → API
# PIT token: GoHighLevel → Settings → Private Integration Token
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PIT_TOKEN=

# ── AI CALLING (Telnyx Assistant IDs for Switchboard) ────────
# Set these if using Tier 2 or 3 (Speed to Lead / Complete Package)
TELNYX_ASSISTANT_ID_AFTER_HOURS=
TELNYX_ASSISTANT_ID_SPEED_TO_LEAD=
TELNYX_ASSISTANT_ID_COMPLETE_PACKAGE=

# ── INSTANTLY (Email Campaigns) ──────────────────────────────
# Required for Tier 3. Get from: app.instantly.ai → Settings → API
INSTANTLY_API_KEY=

# ── N8N (Automation Workflows) ───────────────────────────────
# Required for Tier 3. Point to your n8n instance.
N8N_API_KEY=
N8N_BASE_URL=https://your-n8n.up.railway.app

# ── SWITCHBOARD (AI Call Platform) ───────────────────────────
# Required for Tier 2 and 3.
SWITCHBOARD_URL=https://your-switchboard.up.railway.app
SWITCHBOARD_API_KEY=

# ── SLACK (Alerts & Hand-Raises) ─────────────────────────────
# Required for Tier 3. Create a Slack app and get a Bot token.
# Bot needs: channels:history, channels:read permissions
SLACK_BOT_TOKEN=xoxb-
SLACK_HAND_RAISES_CHANNEL=hand-raises
SLACK_ALERTS_CHANNEL=alerts

# ── LLM PROVIDER ─────────────────────────────────────────────
# Leave as anthropic unless you want to use OpenRouter
LLM_PROVIDER=anthropic
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-4-5

# ── FRONTEND ─────────────────────────────────────────────────
# Set to your Railway public URL (or * for all origins)
FRONTEND_URL=*

# ── OPTIONAL: VAPI / OPENAI ──────────────────────────────────
VAPI_API_KEY=
OPENAI_API_KEY=
